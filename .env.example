# --- Database -------------------------------------------------------------
# Neon: use the *pooled* connection string from the Neon console
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Local Postgres works too (the `pg` driver is used automatically for non-Neon hosts).
DATABASE_URL=postgresql://localhost:5432/poemhub_dev
# Optional: direct (non-pooled) URL used only for migrations. Neon's Vercel
# integration sets this automatically.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth -----------------------------------------------------------------
# Secret for HMAC-ing OTP codes and signing unlock cookies. >= 32 chars.
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: restrict who can become an editor. Comma-separated emails and/or
# @domains, e.g. "alice@example.com,@mypoetryclub.org". Empty = anyone.
EDITOR_ALLOWLIST=

# --- Email ----------------------------------------------------------------
# Required, locally too: sign-in codes are always sent as real emails (see docs/DEPLOY.md §3).
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="InkBoard <login@yourdomain.com>"

# Public base URL (used in emails)
APP_URL=http://localhost:3000

# Number of proxies in front of the app that append to X-Forwarded-For
# (used to find the real client IP for rate limiting). Vercel: 1.
TRUSTED_PROXY_HOPS=1

# Secret for the daily cleanup job (/api/cron/cleanup). Vercel Cron sends it
# automatically when set as CRON_SECRET in the project. >= 32 random chars.
CRON_SECRET=

# Notifications about new poems (docs/NOTIFICATIONS.md). Optional: without
# keys the feature is off. Generate with `pnpm exec web-push generate-vapid-keys`.
# The private key is a secret; never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# An https URL or mailto: on a real domain (defaults to APP_URL when that is
# public https). Required locally: localhost isn't accepted by Apple.
VAPID_SUBJECT=

# Profile photos (docs/PLAN.md, Phase 22; setup: docs/DEPLOY.md, "Profile
# photos: Cloudflare R2"). All four or none. Without them, development, tests
# and E2E keep photos in the gitignored .storage/ folder (PHOTO_STORAGE_DIR
# changes which one); production without them refuses uploads with a clear
# error. Check them with `pnpm storage:check`. The secret is a secret.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
