# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/.next-offline/
/.next-preview/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit secrets. This covers .env, .env.local,
# .env.development.local, .env.production etc. in any folder, plus other
# common naming styles. Only the placeholder template below is tracked.
.env
.env.local
.env*
**/.env*
*.env
*.env.local
.envrc
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# e2e
/test-results/
/playwright-report/
/.next-build/

# video walkthroughs: recordings, renders, builds (see video/README.md)
/video/.out/
/.storage/
