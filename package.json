{
  "name": "poemhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/check-migrations.ts && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:check": "tsx scripts/check-migrations.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@usenavii/core": "0.10.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sileo": "0.1.6",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
