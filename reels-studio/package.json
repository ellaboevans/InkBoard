{
  "name": "inkboard-reels-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "InkBoard's vertical launch Reel, built with Remotion. Lives beside the app; imports nothing from it.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts",
    "render": "remotion render src/index.ts LaunchReel out/reel-video.mp4 --concurrency=2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "remotion": "4.0.541",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3"
  }
}
